/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control system with user-ownership for personal data.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile data. Only the user themselves or an admin can read/write.
 * - /campaigns/{campaignId}: Stores marketing campaign data. Accessible to the client who owns the campaign or an admin.
 * - /chats/{chatId}: Stores chat threads. Only participants or admins can access chats.
 * - /campaigns/{campaignId}/daily_metrics/{metricId}: Stores daily campaign metrics.  Accessible to the campaign owner or an admin.
 * - /channel_summaries/{userId}/summaries/{channelId}: Stores channel summaries for a user.
 * - /events/{eventId}: Stores system events.
 * - /users/{userId}/notifications/{notificationId}: Stores notifications for admins.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Admin role is required to read any user's profile.
 * - Campaigns are owned by a specific client (clientId). Only the client or an admin can read/write.
 * - Chat access is restricted to participants or admins.
 * - Events are globally readable, but writes are restricted (likely to a service account via Cloud Functions).
 * - Notifications are stored under the user's profile and are only intended for admins.
 * - List operations on the /users collection are denied to prevent unauthorized data access. Admins must use explicit queries.
 *
 * Denormalization for Authorization:
 * - Campaigns have a `clientId` field to directly associate them with a user.
 * - Chats have a `participants` array storing user IDs who have access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

     /**
      * @description Checks if the user has the "admin" role by reading their document.
      * @return True if the user document exists, and its "role" field is "admin". False otherwise.
      */
     function isAdmin() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
     }

    /**
     * @description Checks if the user is an existing owner.  Ensures the document exists and the user owns it.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (read) User A (auth UID: user_a) reading their own profile (document ID: user_a).
     * @allow (read) Admin user (auth UID: admin_user, role: admin) reading any user profile.
     * @allow (write) User A (auth UID: user_a) writing to their own profile (document ID: user_a).
     * @deny (read) User B (auth UID: user_b) reading User A's (document ID: user_a) profile.
     * @deny (write) User B (auth UID: user_b) writing to User A's (document ID: user_a) profile.
     * @principle Enforces user-ownership and admin access for user profiles.
     */
    match /users/{userId} {
      // Anyone logged in can read their own profile
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if false; // Prevent listing of all users.

      // Users can write only their own profile
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    /**
     * @description Rules for the /campaigns/{campaignId} collection.
     * @path /campaigns/{campaignId}
     * @allow (read) Client A (auth UID: user_a) reading a campaign where clientId == user_a.
     * @allow (write) Client A (auth UID: user_a) writing to a campaign where clientId == user_a.
     * @allow (read) Admin (auth UID: admin_user, role: admin) reading any campaign.
     * @allow (write) Admin (auth UID: admin_user, role: admin) writing to any campaign.
     * @deny (read) Client B (auth UID: user_b) reading a campaign where clientId == user_a.
     * @deny (write) Client B (auth UID: user_b) writing to a campaign where clientId == user_a.
     * @principle Enforces client-ownership or admin access for campaigns.
     */
    match /campaigns/{campaignId} {
      allow get: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.clientId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && resource != null && (resource.data.clientId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && resource != null && (resource.data.clientId == request.auth.uid || isAdmin());
    }

    /**
     * @description Rules for the /chats/{chatId} collection.
     * @path /chats/{chatId}
     * @allow (read) User A (auth UID: user_a) reading a chat where user_a is in the participants array.
     * @allow (write) User A (auth UID: user_a) writing to a chat where user_a is in the participants array.
     * @allow (read) Admin (auth UID: admin_user, role: admin) reading any chat.
     * @allow (write) Admin (auth UID: admin_user, role: admin) writing to any chat.
     * @deny (read) User B (auth UID: user_b) reading a chat where user_b is not in the participants array.
     * @deny (write) User B (auth UID: user_b) writing to a chat where user_b is not in the participants array.
     * @principle Enforces participant-only or admin access for chats.
     */
    match /chats/{chatId} {
      allow get: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participants || isAdmin());
      allow update: if isSignedIn() && resource != null && (request.auth.uid in resource.data.participants || isAdmin());
      allow delete: if isSignedIn() && resource != null && (request.auth.uid in resource.data.participants || isAdmin());
    }

    /**
     * @description Rules for the /campaigns/{campaignId}/daily_metrics/{metricId} collection.
     * @path /campaigns/{campaignId}/daily_metrics/{metricId}
     */
    match /campaigns/{campaignId}/daily_metrics/{metricId} {
       allow get: if isSignedIn() && (get(/databases/$(database)/documents/campaigns/$(campaignId)).data.clientId == request.auth.uid || isAdmin());
       allow list: if isSignedIn() && (get(/databases/$(database)/documents/campaigns/$(campaignId)).data.clientId == request.auth.uid || isAdmin());
       allow create: if isSignedIn() && (get(/databases/$(database)/documents/campaigns/$(campaignId)).data.clientId == request.auth.uid || isAdmin());
       allow update: if isSignedIn() && resource != null && (get(/databases/$(database)/documents/campaigns/$(campaignId)).data.clientId == request.auth.uid || isAdmin());
       allow delete: if isSignedIn() && resource != null && (get(/databases/$(database)/documents/campaigns/$(campaignId)).data.clientId == request.auth.uid || isAdmin());
    }

    /**
     * @description Rules for the /channel_summaries/{userId}/summaries/{channelId} collection.
     * @path /channel_summaries/{userId}/summaries/{channelId}
     */
    match /channel_summaries/{userId}/summaries/{channelId} {
        allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (isOwner(userId) || isAdmin());
        allow create: if isSignedIn() && (isOwner(userId) || isAdmin()) && request.resource.data.id == channelId;
        allow update: if isSignedIn() && isExistingOwner(userId) && (request.resource.data.id == resource.data.id || isAdmin());
        allow delete: if isSignedIn() && isExistingOwner(userId) && (resource.data.id == channelId || isAdmin());
    }

    /**
     * @description Rules for the /events/{eventId} collection.
     * @path /events/{eventId}
     * @allow (read) Anyone can read events.
     * @deny (create) Only authenticated users can create events, and only with matching UIDs.
     */
    match /events/{eventId} {
       allow get: if true;
       allow list: if true;
       allow create: if isSignedIn() && (request.resource.data.uid == request.auth.uid || isAdmin());
       allow update: if false;
       allow delete: if false;
    }

    /**
     * @description Rules for the /users/{userId}/notifications/{notificationId} collection.
     * @path /users/{userId}/notifications/{notificationId}
     * @allow (read) Admins can read notifications.
     * @allow (write) Admins can create notifications, ensuring they are for the correct user.
     * @deny (read) Non-admins cannot read notifications.
     * @deny (write) Non-admins cannot create notifications.
     */
    match /users/{userId}/notifications/{notificationId} {
        allow get: if isSignedIn() && isAdmin();
        allow list: if isSignedIn() && isAdmin();
        allow create: if isSignedIn() && isAdmin() && request.resource.data.userId == userId;
        allow update: if isSignedIn() && resource != null && isAdmin();
        allow delete: if isSignedIn() && resource != null && isAdmin();
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}